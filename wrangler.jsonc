{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "minilytics",
  "main": "src/worker/index.ts",
  "compatibility_date": "2025-09-01",
  "observability": { "enabled": true },
  // The only public URL. The thetestingacademy.com zone must be in the Cloudflare account you log in to with
  // wrangler, and this hostname must have no DNS record yet: the first deploy creates the record and the
  // certificate. See PERSONAL-SETUP.md.
  "routes": [{ "pattern": "insights.thetestingacademy.com", "custom_domain": true }],
  // No workers.dev URL, so the login page isn't also public on a hostname that the zone's Access and WAF rules
  // can't cover. Written out even though "routes" already implies it, so it can't flip silently.
  "workers_dev": false,
  // Version URLs (<version>-minilytics.<subdomain>.workers.dev) are created by every deploy and run that
  // version's code against the same database, and Cloudflare documents no expiry, so a version from before a
  // security fix would stay public. Nothing here uses them. When this key is missing, they follow workers.dev.
  "preview_urls": false,
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    // Only API calls run the Worker; the dashboard and /js/script.js are served as free static files.
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "minilytics",
      // Replace with the id printed by `npx wrangler d1 create minilytics`.
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations"
    }
  ]
}
